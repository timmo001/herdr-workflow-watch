{
  "name": "herdr-workflow-watch",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub workflow failure indicators for Herdr workspaces",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@herdr/sdk": "github:timmo001/herdr-ts-sdk#835ad824804a57f4ec635930a66b0b0bc46d776b",
    "@timmo001/effect-gh": "github:timmo001/effect-gh#6b018e31342a1a56df7745e921c78150d234ef06",
    "effect": "4.0.0-rc.117",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.83.0",
    "@timmo001/oxlint-rules": "0.3.5",
    "@types/bun": "1.4.2",
    "@types/proper-lockfile": "4.1.4",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "overrides": {
    "effect": "$effect",
    "@effect/platform-node-shared": "$@effect/platform-node"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ]
}
