{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:monorepos",
    "group:recommended"
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "minimumReleaseAge": "2 days",
  "packageRules": [
    {
      "description": "Update first-party packages and workflows without a release delay.",
      "matchPackageNames": ["@timmo001/**", "timmo001/workflows"],
      "minimumReleaseAge": null
    },
    {
      "description": "Use the shorter release delay for Effect dependencies.",
      "matchPackageNames": ["effect", "@effect/platform-node", "@effect/tsgo"],
      "minimumReleaseAge": "2 hours"
    }
  ]
}
